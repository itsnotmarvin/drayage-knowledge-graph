<node id="reg_panynj_sealink_twic">
  <data key="d2">SeaLink®; TWIC and SeaLink®</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_panynj_sealink_twic", "label": "SeaLink®; TWIC and SeaLink®", "authority_entity_id": "authority_panynj", "source_id": "panynj_truckers_guide", "source_locator": "PDF page 4, SeaLink® and TWIC and SeaLink®", "source_text": ["SeaLink® is mandatory for all truckers doing business at the Port of New York and New Jersey.", "Anyone with SeaLink® identification must also have a TWIC. You must register your TWIC with the Port Authority at the Truck Service Center. (Registration is free.)"], "source_text_verbatim": true, "keys_on": ["permit_credential_status"], "applicability_status": "confirmed_applicable", "matching_scope_facts": ["vehicle_use=container_drayage", "destination=APM_Terminals_Elizabeth_gate"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
