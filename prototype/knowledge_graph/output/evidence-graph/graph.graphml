  <data key="d3">source_document</data>
  <data key="d4">archive</data>
  <data key="d5">{"source_id": "elizabeth_kapkowski_corridor_concept_report_2022", "title": "Kapkowski Road Corridor Improvements Project Concept Development Report", "publisher": "City of Elizabeth Department of Engineering", "source_type": "official_city_engineering_report", "publication_date": "2022-08-02", "traffic_collection_dates": "2020-10-19 through 2020-10-26", "accessed_date": "2026-08-20", "url": "https://www.elizabethnj.org/DocumentCenter/View/5308/01_Kapkowski-Rd-Corridor-Improvements-Final-CD-Rept-0822", "extract_note": "The report used seven continuous seven-day ATR counts and 12 turning-movement counts. It identified LOS E movements at North Avenue/Dowd Avenue and North Avenue/Kapkowski Road–IKEA Drive. Pandemic-era observations were compared with 2018 pre-pandemic counts and adjusted by time period."}</data>
