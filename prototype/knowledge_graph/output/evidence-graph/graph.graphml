  <data key="d5">{"profile_id": "representative_older_engine_drayage", "fact_basis": "representative_profile_defined_for_rule_matching", "definition_note": "Defined per the project brief as groundwork for rule-to-profile matching; property values are chosen from thresholds in extracted rules, not observed from a real vehicle.", "applicability_scope_note": "Applicability statuses in regulatory_nodes.json are classifications for the canonical scoped profile. The interactions below are threshold matches for this defined representative profile only and are not compliance findings.", "defined_facts": {"vehicle_use": "container_drayage", "configuration": "standard_five_axle_tractor_semitrailer", "gross_weight_lbs": 80000, "axle_count": 5, "engine_model_year": 2007, "width_inches": 102, "height_inches": 162, "semitrailer_length_feet": 40, "cargo_hazardous": false, "credential_status": "cdl_twic_sealink_rfid_assumed_held_for_matching"}, "rule_interactions": [{"rule_id": "reg_panynj_dtr_engine", "keyed_property": "engine_model_year", "interaction": "Engine model year 2007 is below the model year 2014 minimum that Subrule 34-1101 requires to complete DTR registration."}, {"rule_id": "reg_panynj_dtr", "keyed_property": "permit_credential_status", "interaction": "DTR registration is required for entry onto any Port Authority terminal; see reg_panynj_dtr_engine for the engine-year condition on completing that registration."}], "compliance_status": "not_a_compliance_claim"}</data>
