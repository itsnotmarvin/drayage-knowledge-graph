  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_nj_height_limit", "label": "NJ Commercial Vehicle Size and Weight Guidebook — 2.1.2 Height (N.J.S.A. 39:3-84.a(2))", "authority_entity_id": "authority_njdot", "source_id": "nj_size_weight_guidebook", "source_locator": "PDF page 14, section 2.1.2", "source_text": "The maximum height of any commercial vehicle or combination of vehicles, including load or contents of any part or portion thereof, traveling within the State of New Jersey is 13’-6” on all highways, except as otherwise identified, as shown in the height diagram above.", "source_text_verbatim": true, "keys_on": ["dimensions"], "applicability_status": "confirmed_applicable_on_new_jersey_roadways", "matching_scope_facts": ["geography=New_Jersey"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
