  <data key="d5">{"rule_id": "reg_nj_access_network_600_series", "label": "N.J.A.C. 16:32-1.4(a)(3) and Appendix C — County 600-series roads", "authority_entity_id": "authority_njdot", "source_id": "njac_16_32_truck_access_current_2023", "source_locator": "PDF page 3, N.J.A.C. 16:32-1.4(a)(3); PDF page 9, Appendix C", "source_text": "Those county \"600\" series roads listed under Appendix C, incorporated herein by reference, approximately 80 miles; and", "source_text_verbatim": true, "appendix_c_route_numbers": [16, 38, 601, 606, 607, 609, 610, 615, 618, 619, 623, 625, 629, 649, 656, 657, 673], "keys_on": ["dimensions"], "applicability_status": "confirmed_cr624_not_designated_as_new_jersey_access_network_route", "matching_scope_facts": ["road=CR624", "vehicle_class_scope=double_trailer_combinations_and_102_inch_wide_standard_trucks"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
