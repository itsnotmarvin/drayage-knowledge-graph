<node id="reg_federal_cdl">
  <data key="d2">49 CFR 383.23 — Commercial driver's license</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_federal_cdl", "label": "49 CFR 383.23 — Commercial driver's license", "authority_entity_id": "authority_fmcsa", "source_id": "ecfr_49_cfr_383_2026_07_29", "source_locator": "49 CFR 383.23(a)(2)", "source_text": "Except as provided in paragraph (b) of this section, no person may legally operate a CMV unless such person possesses a CDL which meets the standards contained in subpart J of this part, issued by his/her State or jurisdiction of domicile.", "source_text_verbatim": true, "keys_on": ["permit_credential_status"], "applicability_status": "confirmed_applicable", "matching_scope_facts": ["reg_federal_group_a_cmv"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
</node>
<node id="reg_federal_group_a_cmv">
  <data key="d2">49 CFR 383.5 — Commercial motor vehicle (CMV), Combination Vehicle (Group A)</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_federal_group_a_cmv", "label": "49 CFR 383.5 — Commercial motor vehicle (CMV), Combination Vehicle (Group A)", "authority_entity_id": "authority_fmcsa", "source_id": "ecfr_49_cfr_383_2026_07_29", "source_locator": "49 CFR 383.5, definition of Commercial motor vehicle (CMV), paragraph (1)", "source_text": "Commercial motor vehicle (CMV) means a motor vehicle or combination of motor vehicles used in commerce to transport passengers or property if the motor vehicle is a— (1) Combination Vehicle (Group A)—having a gross combination weight rating or gross combination weight of 11,794 kilograms or more (26,001 pounds or more), whichever is greater, inclusive of a towed unit(s) with a gross vehicle weight rating or gross vehicle weight of more than 4,536 kilograms (10,000 pounds), whichever is greater;", "source_text_verbatim": true, "keys_on": ["weight"], "applicability_status": "confirmed_applicable", "matching_scope_facts": ["configuration=standard_five_axle_tractor_semitrailer", "gross_weight_lbs=80000"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
</node>
<node id="reg_federal_interstate_weight">
  <data key="d2">23 CFR 658.17 — Weight</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_federal_interstate_weight", "label": "23 CFR 658.17 — Weight", "authority_entity_id": "authority_fhwa", "source_id": "ecfr_23_cfr_658_17_2026_07_29", "source_locator": "23 CFR 658.17(a)-(e)", "source_text": ["(a) The provisions of the section are applicable to the National System of Interstate and Defense Highways and reasonable access thereto.", "(b) The maximum gross vehicle weight shall be 80,000 pounds except where lower gross vehicle weight is dictated by the bridge formula.", "(c) The maximum gross weight upon any one axle, including any one axle of a group of axles, or a vehicle is 20,000 pounds.", "(d) The maximum gross weight on tandem axles is 34,000 pounds.", "(e) No vehicle or combination of vehicles shall be moved or operated on any Interstate highway when the gross weight on two or more consecutive axles exceeds the limitations prescribed by the following formula, referred to as the Bridge Gross Weight Formula:"], "source_text_verbatim": true, "keys_on": ["weight", "axles"], "applicability_status": "confirmed_applicable_path_a_interstate_segment", "matching_scope_facts": ["path_a_exit13a_to_apm", "gross_weight_lbs=80000"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
</node>
<node id="reg_federal_twic">
  <data key="d2">33 CFR 101.514 — TWIC Requirement</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_federal_twic", "label": "33 CFR 101.514 — TWIC Requirement", "authority_entity_id": "authority_uscg", "source_id": "ecfr_33_cfr_101_514_2026_07_29", "source_locator": "33 CFR 101.514(a)", "source_text": "All persons requiring unescorted access to secure areas of vessels, facilities, and OCS facilities regulated by parts 104, 105 or 106 of this subchapter must possess a TWIC before such access is granted, except as otherwise noted in this section. A TWIC must be obtained via the procedures established by TSA in 49 CFR part 1572.", "source_text_verbatim": true, "keys_on": ["permit_credential_status"], "applicability_status": "confirmed_applicable_to_unescorted_secure_access", "matching_scope_facts": ["movement_direction=inbound", "destination=APM_Terminals_Elizabeth_gate"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
</node>
