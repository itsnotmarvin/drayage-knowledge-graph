<node id="reg_nj_truck_access_local_rule_preservation">
  <data key="d2">N.J.A.C. 16:32-1.2(e) — General provisions</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_nj_truck_access_local_rule_preservation", "label": "N.J.A.C. 16:32-1.2(e) — General provisions", "authority_entity_id": "authority_njdot", "source_id": "njac_16_32_truck_access_current_2023", "source_locator": "PDF page 2, N.J.A.C. 16:32-1.2(e)", "source_text": "The rules of this chapter do not supersede other State rules outside of this chapter, municipal ordinances, and county resolutions, which may otherwise restrict or control the through-movements of trucks or other vehicles. An example of such a restriction is a maximum weight posting or the designation of local \"truck route\" restrictions that have been adopted and posted as provided at N.J.S.A. 40:67-16.1 et seq.", "source_text_verbatim": true, "keys_on": [], "applicability_status": "confirmed_rule_scope", "matching_scope_facts": ["geography=New_Jersey"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
</node>
<node id="reg_nj_width_limit">
  <data key="d2">NJ Commercial Vehicle Size and Weight Guidebook — 2.1.1 Width (N.J.S.A. 39:3-84.a(1))</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_nj_width_limit", "label": "NJ Commercial Vehicle Size and Weight Guidebook — 2.1.1 Width (N.J.S.A. 39:3-84.a(1))", "authority_entity_id": "authority_njdot", "source_id": "nj_size_weight_guidebook", "source_locator": "PDF page 13, section 2.1.1", "source_text": ["Width 96 inches on routes that are not National Network or NJ Access Routes 102 inches on National Network and NJ Access Routes", "As the diagram above shows, the maximum width of a commercial vehicle traveling within the State of New Jersey is 102 inches (or 8 feet 6 inches). In some instances, rules and regulations may be promulgated for those public roads, streets or highways or public or quasi-public property in this State, where it is determined that the interests of public safety and welfare require the maximum outside width be no more than 96 inches."], "source_text_verbatim": true, "keys_on": ["dimensions"], "applicability_status": "confirmed_applicable_on_new_jersey_roadways_limit_depends_on_route_network_status", "matching_scope_facts": ["geography=New_Jersey"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
</node>
<node id="reg_njta_roadway_use_limitations">
  <data key="d2">N.J.A.C. 19:9-1.9 — Limitations on use of Roadway (selected vehicle prohibitions)</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_njta_roadway_use_limitations", "label": "N.J.A.C. 19:9-1.9 — Limitations on use of Roadway (selected vehicle prohibitions)", "authority_entity_id": "authority_njta", "source_id": "njac_19_9_1_9_cornell_2026_08_07", "source_locator": "N.J.A.C. 19:9-1.9(a), introductory paragraph and items 21 and 24", "source_text": ["(a) Use of the Roadway and entry thereon by the following, unless otherwise authorized by the Authority, is prohibited:", "21. Commercial motor vehicles, trailers and semitrailers, including, but not limited to, farm trucks, while loaded with hay or straw when the extreme overall dimension is greater than 102 inches in width, without special permit;", "24. Vehicles operated with a tandem trailer combination, commonly known as a \"double bottom,\" if one or more of the individual trailers exceeds 28 feet, six inches in length;"], "source_text_verbatim": true, "keys_on": ["dimensions", "permit_credential_status"], "applicability_status": "confirmed_applicable_on_turnpike_authority_roadway", "matching_scope_facts": ["edge_a_exit13a_connector", "configuration=standard_five_axle_tractor_semitrailer"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
</node>
<node id="reg_panynj_drayage_truck_deadline_34_1140">
  <data key="d2">SUBRULE 34-1140: DRAYAGE TRUCK DEADLINE</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_panynj_drayage_truck_deadline_34_1140", "label": "SUBRULE 34-1140: DRAYAGE TRUCK DEADLINE", "authority_entity_id": "authority_panynj", "source_id": "panynj_marine_terminal_tariff", "source_locator": "Subrule 34-1140, PDF page 56", "source_text": {"effective_2023_07_02": {"intro": "Beginning July 2, 2023, at 12:01 AM, no Container Terminal Facility shall permit access into any Port Authority Terminal by:", "clauses": ["a) Any Drayage Truck that cannot be verified as compliant by reference to the Drayage Truck’s records in the DTR, or", "b) Any Drayage Truck equipped with an engine of model year 1998 or older, or", "c) Any Drayage Truck that is not an Alternative Drayage Truck as defined in SUBRULE 34-1060."]}, "effective_2027_05_01": {"intro": "Beginning May 1, 2027, at 12:01 AM, no Container Terminal Facility shall permit access into any Port Authority Terminal by:", "clauses": ["a) Any Drayage Truck that cannot be verified as compliant by reference to the Drayage Truck’s records in the DTR, or", "b) Any Drayage Truck equipped with an engine of model year 1999 or older, or", "c) Any Drayage Truck that is not an Alternative Truck as defined in SUBRULE 34-1060."]}, "effective_2028_05_01": {"intro": "Beginning May 1, 2028, at 12:01 AM, no Container Terminal Facility shall permit access into any Port Authority Terminal by:", "clauses": ["a) Any Drayage Truck that cannot be verified as compliant by reference to the Drayage Truck’s records in the DTR, or", "b) Any Drayage Truck equipped with an engine of model year 2000 or older, or", "c) Any Drayage Truck that is not an Alternative Truck as defined in SUBRULE 34-1060."]}}, "source_text_verbatim": true, "transcription_note": "The source changes 'Alternative Drayage Truck' in the 2023 block to 'Alternative Truck' in the 2027 and 2028 blocks; that wording is preserved exactly.", "keys_on": ["engine_model_year", "fuel_powertrain_type", "permit_credential_status"], "applicability_profile_id": "scoped_80000lb_5axle_nonhaz_inbound_apm", "required_profile_facts": ["engine_model_year", "fuel_powertrain_type", "dtr_verification_status"], "missing_profile_facts": ["engine_model_year", "fuel_powertrain_type", "dtr_verification_status"], "applicability_status": "unresolved_internal_text_tension_no_profile_application", "interpretation_status": "unresolved_internal_text_tension", "matching_scope_facts": ["vehicle_use=container_drayage"], "related_rule_ids": ["reg_panynj_dtr", "reg_panynj_dtr_engine"], "interpretation_boundary": "The retained tariff text does not reconcile Subrule 34-1140(c) with Subrule 34-1101's diesel-engine DTR registration pathway. The repository preserves both clauses and makes no denial, compliance, contradiction, enforcement, or route-feasibility inference.", "named_blocker": "PANYNJ authoritative clarification, erratum, or superseding PA-10 text resolving Subrule 34-1140(c)", "compliance_status": "not_a_compliance_claim", "graph_eligibility": "exclude_unresolved_not_for_verified_visual"}</data>
</node>
<node id="reg_panynj_dtr">
  <data key="d2">SUBRULE 34-1100: REGISTRATION IN DRAYAGE TRUCK REGISTRY (DTR)</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_panynj_dtr", "label": "SUBRULE 34-1100: REGISTRATION IN DRAYAGE TRUCK REGISTRY (DTR)", "authority_entity_id": "authority_panynj", "source_id": "panynj_marine_terminal_tariff", "source_locator": "Subrule 34-1100, PDF page 55", "source_text": "All Drayage Trucks seeking entry onto any Port Authority Terminal shall be registered in the DTR prior to the date of entry. Registration in the DTR shall be in electronic format via the PortTruckPass (PTP) website (www.porttruckpass.com). In the event of a change to the information provided for registration in the DTR with respect to a registered vehicle, such information shall be amended within ten (10) calendar days of the change via the PortTruckPass website (www.porttruckpass.com). Supporting documentation may be required for verification purposes with regard to registration or amendment.", "source_text_verbatim": true, "keys_on": ["permit_credential_status"], "applicability_status": "confirmed_applicable", "matching_scope_facts": ["vehicle_use=container_drayage", "destination=APM_Terminals_Elizabeth_gate"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
</node>
<node id="reg_panynj_dtr_engine">
  <data key="d2">SUBRULE 34-1101: REGISTRATION IN DRAYAGE TRUCK REGISTRY (DTR)</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_panynj_dtr_engine", "label": "SUBRULE 34-1101: REGISTRATION IN DRAYAGE TRUCK REGISTRY (DTR)", "authority_entity_id": "authority_panynj", "source_id": "panynj_marine_terminal_tariff", "source_locator": "Subrule 34-1101, PDF page 56", "source_text": "Beginning July 2, 2023 at 12:01 AM, only Drayage Trucks that are equipped with an engine that meets or exceeds federal Environmental Protection Agency on-road emission standards for engine model year 2014 heavy-duty diesel-fueled shall be permitted to complete registration in the DTR via the PortTruckPass website (www.porttruckpass.com).", "source_text_verbatim": true, "keys_on": ["engine_model_year"], "applicability_status": "confirmed_requirement_for_completing_dtr_registration", "matching_scope_facts": ["vehicle_use=container_drayage"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include_as_verified_requirement"}</data>
</node>
<node id="reg_panynj_rfid">
  <data key="d2">Radio-Frequency Identification (RFID)</data>
  <data key="d3">source_clause</data>
  <data key="d4">archive</data>
  <data key="d5">{"rule_id": "reg_panynj_rfid", "label": "Radio-Frequency Identification (RFID)", "authority_entity_id": "authority_panynj", "source_id": "panynj_truckers_guide", "source_locator": "PDF page 4, Radio-Frequency Identification (RFID)", "source_text": ["All Class 8 drayage trucks seeking entry onto any Port of New York and New Jersey Marine Terminal must be registered in the Drayage Truck Registry (DTR) and have a valid RFID tag properly mounted on the vehicle.", "No tag, no entry."], "source_text_verbatim": true, "keys_on": ["weight", "permit_credential_status"], "applicability_status": "confirmed_applicable", "matching_scope_facts": ["vehicle_use=container_drayage", "gross_weight_lbs=80000", "destination=APM_Terminals_Elizabeth_gate"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include"}</data>
