  <data key="d5">{"rule_id": "reg_elizabeth_north_avenue_east_zone", "label": "10.16.050 — An 80,000 pound overweight vehicle zone limit—Streets affected", "authority_entity_id": "authority_elizabeth_city", "source_id": "elizabeth_code_10_16_050_2025_11_11", "source_locator": "Elizabeth Code of Ordinances 10.16.050, street table", "source_text": {"street": "North Avenue East", "location": "Beginning at a point 440 feet east of the intersection of North Avenue East and Kapkowski Road and continuing east 520 feet to the vacated portion of North Avenue East and its connection to the Port Authority over weight vehicle zone."}, "source_text_verbatim": true, "keys_on": ["weight"], "applicability_status": "confirmed_geographic_overlap_only", "matching_scope_facts": ["edge_shared_north_avenue"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include_as_exact_local_code_record"}</data>
