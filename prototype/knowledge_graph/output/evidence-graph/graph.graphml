  <data key="d5">{"rule_id": "reg_elizabeth_four_ton_limit_streets", "label": "10.16.010 — Four-ton weight limit—Streets affected", "authority_entity_id": "authority_elizabeth_city", "source_id": "elizabeth_code_10_16_050_2025_11_11", "source_locator": "Elizabeth Code of Ordinances 10.16.010, operative paragraph and street table (132 street entries)", "source_text": "Trucks over four (4) tons gross weight are excluded from the street or parts of street described, except for the pickup and delivery of materials on such street.", "source_text_verbatim": true, "restriction_table_row_count": 132, "restriction_table_note": "The full 132-row street table is preserved verbatim in the archived Municode chapter content; North Avenue appears in it only as a location boundary for other streets' restricted segments, never as a restricted street.", "keys_on": ["weight"], "applicability_status": "confirmed_route_streets_not_listed_in_street_table", "matching_scope_facts": ["gross_weight_lbs=80000", "edge_b_north_avenue_to_merge", "edge_shared_north_avenue", "edge_shared_mclester", "edge_shared_tripoli_gate"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include_as_verified_restriction_with_route_street_absence"}</data>
