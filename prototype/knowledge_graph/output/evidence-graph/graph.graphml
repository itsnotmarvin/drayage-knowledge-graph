  <data key="d5">{"rule_id": "reg_elizabeth_five_ton_limit_streets", "label": "10.16.040 — Five-ton weight limit for trucks—Streets affected", "authority_entity_id": "authority_elizabeth_city", "source_id": "elizabeth_code_10_16_050_2025_11_11", "source_locator": "Elizabeth Code of Ordinances 10.16.040, street table", "source_text": {"table_heading": ["Name of Street", "Location"], "rows": [["Westminster Avenue", ""], ["Wilder Street", "From North Broad Street to the City Line (Except for pick-up and deliveries)"]], "prior_code_note": "(Prior code § 141-84)"}, "source_text_verbatim": true, "section_prose_note": "The section contains no operative prose paragraph; its content is the table transcribed above.", "keys_on": ["weight"], "applicability_status": "confirmed_route_streets_not_listed_in_street_table", "matching_scope_facts": ["gross_weight_lbs=80000", "edge_b_north_avenue_to_merge", "edge_shared_north_avenue", "edge_shared_mclester", "edge_shared_tripoli_gate"], "compliance_status": "not_a_compliance_claim", "graph_eligibility": "include_as_verified_restriction_with_route_street_absence"}</data>
